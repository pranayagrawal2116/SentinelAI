# ==============================================================================
# SentinelAI - Git Ignore Configuration
# ==============================================================================

# Operating System files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# Python runtime & build artifacts
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.coverage
htmlcov/
.env
.venv
env/
venv/
ENV/

# CatBoost & ML training artifacts
catboost_info/
**/catboost_info/

# Node.js & Vite build artifacts
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
**/dist/
.vite/
**/.vite/

# ------------------------------------------------------------------------------
# Large Datasets (>50MB / Raw Data)
# Note: Raw CICIoT2023 PCAP CSVs and full split files are generated on-demand
# by running python sentinel-ai/backend/auto_run.py.
# ------------------------------------------------------------------------------
data/raw/
**/data/raw/
*.pcap.csv
legacy_v1/*.csv
sentinel-ai/backend/data/*.csv
sentinel-ai/backend/demo_scenarios/frontend_test_set.csv
*.csv.gz
*.tar.gz
*.zip

# Keep lightweight sample for out-of-the-box demonstration (5,000 rows ~ 1MB)
!sentinel-ai/backend/demo_scenarios/frontend_test_sample.csv

# Parquet training partitions (can be regenerated via pipeline)
# Note: features.json, scaler.pkl, and label_encoder.pkl remain tracked
*.parquet
**/*.parquet

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
